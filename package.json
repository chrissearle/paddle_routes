{
  "name": "paddle",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm cache:tracks && pnpm cache:geojson && nuxt build",
    "cache:tracks": "tsx scripts/build-track-cache.ts",
    "cache:geojson": "tsx scripts/build-geojson-cache.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "prepare": "husky",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "pnpm lint:fix",
    "*.{md,json,css,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "fast-xml-parser": "5.11.2",
    "leaflet": "1.9.4",
    "nuxt": "4.6.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.118",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/scripts": "1.3.12",
    "@prometheus-io/client": "0.16.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
